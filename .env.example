MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WA_ADMIN_NUMBER="6285664943141"
WA_ADMIN_NUMBER_SECONDARY="6282374236585"

REVERB_APP_ID=
